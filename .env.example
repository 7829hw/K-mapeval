# OpenAI or an OpenAI-compatible chat-completions endpoint.
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4.1-mini
# Leave blank for the official OpenAI endpoint.
LLM_BASE_URL=
# Both upstreams decode greedily (temperature=0). Leaving this unset would hand the endpoint's
# own default, which is what made two floor runs over one benchmark differ by 11 points.
LLM_TEMPERATURE=0
# Generous on purpose: a short timeout does not make a busy endpoint answer sooner, it only turns
# a slow answer into a lost question.
LLM_TIMEOUT_SECONDS=1800
# Everything except 400/413/422 (which describe the request we sent) is waited out with exponential
# backoff and jitter, capped at 60s per delay.
LLM_MAX_RETRIES=8
LLM_RETRY_BACKOFF_SECONDS=5
MAX_REASONING_STEPS=8
BENCHMARK_CONCURRENCY=4
# Ask a single question again when an API, not the agent, is what failed it. Wrong answers and
# place-not-found are never retried. 0 disables.
BENCHMARK_QUESTION_RETRIES=2
BENCHMARK_QUESTION_RETRY_BACKOFF_SECONDS=10

# Everything below is needed only for --provider kakao. The default run answers from the context
# each dataset row ships, which calls nothing.
# Kakao Developers REST API key used by both Local and Mobility APIs.
KAKAO_REST_API_KEY=your-kakao-rest-api-key
# Region prior for name lookups, as "latitude,longitude". Korean POI names repeat across cities, so
# a nationwide keyword search resolves an ambiguous name to whichever city ranks first. This biases
# every lookup identically for both agents; a name with no match in the region still resolves
# nationwide. Blank disables it. 37.5665,126.9780 is Seoul City Hall; radius max is 20000.
KAKAO_SEARCH_CENTER=
KAKAO_SEARCH_RADIUS_M=20000
KAKAO_TIMEOUT_SECONDS=30
KAKAO_CACHE_DB_PATH=data/kakao_cache.db
# 0 means entries never expire. Default: 86400 seconds (24 hours).
KAKAO_CACHE_TTL_SECONDS=86400
