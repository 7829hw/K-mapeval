# OpenAI or an OpenAI-compatible chat-completions endpoint. Both vendored architectures are
# built from these: `main.build_llm` constructs one `langchain_openai.ChatOpenAI` and gives it
# to the MapEval-API baseline and to Spatial-Agent alike, so an accuracy difference between
# them is never a difference in decoding.
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4.1-mini
# Leave blank for the official OpenAI endpoint.
LLM_BASE_URL=
# Generous on purpose: a short timeout does not make a busy endpoint answer sooner, it only turns
# a slow answer into a lost question.
LLM_TIMEOUT_SECONDS=1800
LLM_MAX_RETRIES=8
LLM_RETRY_BACKOFF_SECONDS=5
# The ReAct baseline's step budget (`initialize_agent(max_iterations=...)`). Langchain's default
# is 15; 30 is deliberate, because on five primitives a four-stop itinerary needs eight tool
# turns before any arithmetic. Do not cut it to make a gap appear.
MAX_REASONING_STEPS=30
BENCHMARK_CONCURRENCY=4
# Ask a single question again when an API, not the agent, is what failed it. Wrong answers and
# a place Kakao does not carry are never retried. 0 disables.
BENCHMARK_QUESTION_RETRIES=2
BENCHMARK_QUESTION_RETRY_BACKOFF_SECONDS=10

# Kakao Developers REST API key, used by both Kakao Local and Kakao Mobility. Required: this
# port has no offline evidence source, so every run queries Kakao.
KAKAO_REST_API_KEY=your-kakao-rest-api-key
# Region prior for name lookups, as "latitude,longitude". Korean POI names repeat across cities,
# so a nationwide keyword search resolves an ambiguous name to whichever city ranks first. This
# biases the first query identically for both agents; a name with no match in the region still
# resolves nationwide, so the prior can never hide a place. Blank disables it.
# 37.5665,126.9780 is Seoul City Hall; radius max is 20000.
KAKAO_SEARCH_CENTER=
KAKAO_SEARCH_RADIUS_M=20000
KAKAO_TIMEOUT_SECONDS=30
# Kakao responses and the place table `get_place_details` is served from. Blank disables the
# cache entirely. 0 TTL means entries never expire.
KAKAO_CACHE_DB_PATH=data/kakao_cache.db
KAKAO_CACHE_TTL_SECONDS=86400
# RECOMMEND, TIME or DISTANCE. Only DISTANCE is reproducible: RECOMMEND and TIME both optimize
# against live speeds, so the same pair can answer 17.9 km and then 23.0 km.
KAKAO_ROUTE_PRIORITY=RECOMMEND

# Upstream's MapEval-API tools slept 30 s after every successful call, for the hosted MapQaTor
# backend's rate limit. Kakao served directly needs none; raise it only if you hit a quota.
MAPEVAL_TOOL_SLEEP_SECONDS=0
