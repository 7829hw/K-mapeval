# OpenAI or an OpenAI-compatible chat-completions endpoint.
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4.1-mini
# Leave blank for the official OpenAI endpoint.
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=120
# Transient 5xx/429/connection errors are retried with exponential backoff before a question fails.
LLM_MAX_RETRIES=4
LLM_RETRY_BACKOFF_SECONDS=2
MAX_REASONING_STEPS=8
BENCHMARK_CONCURRENCY=4
# Stop the batch after this many consecutive questions die on the LLM endpoint. 0 disables.
BENCHMARK_ABORT_AFTER_LLM_FAILURES=10

# Kakao Developers REST API key used by both Local and Mobility APIs.
KAKAO_REST_API_KEY=your-kakao-rest-api-key
# Region prior for name lookups, as "latitude,longitude". Korean POI names repeat across cities, so
# a nationwide keyword search resolves an ambiguous name to whichever city ranks first. This biases
# every lookup identically for both agents; a name with no match in the region still resolves
# nationwide. Blank disables it. 37.5665,126.9780 is Seoul City Hall; radius max is 20000.
KAKAO_SEARCH_CENTER=
KAKAO_SEARCH_RADIUS_M=20000
KAKAO_TIMEOUT_SECONDS=15
KAKAO_CACHE_DB_PATH=data/kakao_cache.db
# 0 means entries never expire. Default: 86400 seconds (24 hours).
KAKAO_CACHE_TTL_SECONDS=86400
