# OpenAI or an OpenAI-compatible chat-completions endpoint.
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4.1-mini
# Leave blank for the official OpenAI endpoint.
LLM_BASE_URL=
MAX_REASONING_STEPS=8
BENCHMARK_CONCURRENCY=4

# Kakao Developers REST API key used by both Local and Mobility APIs.
KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_TIMEOUT_SECONDS=15
KAKAO_CACHE_DB_PATH=data/kakao_cache.db
# 0 means entries never expire. Default: 86400 seconds (24 hours).
KAKAO_CACHE_TTL_SECONDS=86400
